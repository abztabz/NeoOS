{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoos.local/schemas/report-v1.1.json",
  "title": "NeoOS Daily Report v1.1",
  "description": "Extends v1.0 with optional workspace sections. Missing sections fall back to labeled demo content in the UI. v1.0 reports remain importable via migration.",
  "type": "object",
  "required": ["schemaVersion", "asOf", "mode", "deployment", "scores", "radar", "assets"],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "asOf": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["demo", "live"] },
    "deployment": {
      "type": "object",
      "required": ["score", "recommendation", "posture", "reasons"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "recommendation": { "type": "string" },
        "posture": { "type": "string" },
        "reasons": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "scores": {
      "type": "object",
      "required": ["cash", "market", "opportunity", "confidence", "evidenceIntegrity", "reserveHealth"],
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "radar": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "title", "detail"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["info", "positive", "caution", "risk"] },
          "title": { "type": "string" },
          "detail": { "type": "string" }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "score", "rating", "confidence"],
        "properties": {
          "id": { "type": "string" },
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "rating": { "enum": ["Strong Buy", "Buy", "Accumulate", "Hold", "Reduce", "Sell", "Avoid"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
          "intrinsicValueLow": { "type": ["number", "null"] },
          "intrinsicValueHigh": { "type": ["number", "null"] },
          "buyBelow": { "type": ["number", "null"] },
          "strongBuyBelow": { "type": ["number", "null"] }
        }
      }
    },
    "regime": { "type": "string" },
    "commentary": { "type": "string" },
    "markets": {
      "type": "object",
      "required": ["macroContext", "regions"],
      "properties": {
        "macroContext": { "type": "string" },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "score", "stance", "note"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "score": { "type": "number", "minimum": 0, "maximum": 100 },
              "stance": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "portfolio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assetId", "allocation", "targetRange", "thesisStatus", "keyRisks", "reviewTrigger", "role", "tier"],
        "properties": {
          "assetId": { "type": "string" },
          "allocation": { "type": "string" },
          "targetRange": { "type": "string" },
          "thesisStatus": { "type": "string" },
          "keyRisks": { "type": "array", "items": { "type": "string" } },
          "reviewTrigger": { "type": "string" },
          "role": { "type": "string" },
          "tier": { "type": "string" }
        }
      }
    },
    "gold": {
      "type": "object",
      "required": ["factors", "fairValueLow", "fairValueHigh", "role"],
      "properties": {
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "score", "note"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "score": { "type": "number", "minimum": 0, "maximum": 100 },
              "note": { "type": "string" }
            }
          }
        },
        "fairValueLow": { "type": ["number", "null"] },
        "fairValueHigh": { "type": ["number", "null"] },
        "role": { "type": "string" }
      }
    },
    "cash": {
      "type": "object",
      "required": ["available", "emergencyReserve", "deployable", "monthlySurplus", "cashYieldPct", "opportunityCost", "recommendation"],
      "properties": {
        "available": { "type": "number" },
        "emergencyReserve": { "type": "number" },
        "deployable": { "type": "number" },
        "monthlySurplus": { "type": "number" },
        "cashYieldPct": { "type": "number" },
        "opportunityCost": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "kind", "cashScore", "deploymentPct", "detail"],
        "properties": {
          "id": { "type": "string" },
          "date": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "enum": ["deployment", "cash", "rating", "decision", "evidence"] },
          "cashScore": { "type": ["number", "null"] },
          "deploymentPct": { "type": ["number", "null"] },
          "detail": { "type": "string" }
        }
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "score", "status"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "status": { "type": "string" }
        }
      }
    },
    "deploymentPlan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "value", "note"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
