{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neoos.local/schemas/engine-report-v2.0.json",
  "title": "NeoOS Engine Report v2.0",
  "description": "Auditable engine report plus its derived presentation view. The engine payload carries the full calculation trace; the view is the v1.1 presentation projection the UI renders. Authoritative definition: src/engine/models.ts.",
  "type": "object",
  "required": ["schemaVersion", "engine", "view"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "view": { "$ref": "https://neoos.local/schemas/report-v1.1.json" },
    "engine": {
      "type": "object",
      "required": [
        "schemaVersion",
        "metadata",
        "assets",
        "evidence",
        "conflicts",
        "recommendations",
        "posture",
        "evidenceSummary",
        "changeLog",
        "warnings",
        "insufficientEvidenceItems",
        "journalEntry"
      ],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "metadata": {
          "type": "object",
          "required": ["generatedAt", "evidenceUpdatedAt", "engineVersion", "mode", "previousReportHash"],
          "properties": {
            "generatedAt": { "type": "string", "format": "date-time" },
            "evidenceUpdatedAt": { "type": "string", "format": "date-time" },
            "engineVersion": { "type": "string" },
            "mode": { "enum": ["demo", "live"] },
            "previousReportHash": { "type": ["string", "null"] }
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assetId", "name", "kind", "currency", "assetClass", "category", "region", "status", "sourceIdentifiers"],
            "properties": {
              "assetId": { "type": "string" },
              "name": { "type": "string" },
              "kind": { "enum": ["instrument", "category"] },
              "ticker": { "type": ["string", "null"] },
              "exchange": { "type": ["string", "null"] },
              "currency": { "type": "string" },
              "assetClass": { "type": "string" },
              "category": { "type": "string" },
              "sector": { "type": ["string", "null"] },
              "industry": { "type": ["string", "null"] },
              "country": { "type": ["string", "null"] },
              "region": { "type": "string" },
              "benchmark": { "type": ["string", "null"] },
              "status": { "enum": ["active", "watch", "excluded"] },
              "sourceIdentifiers": { "type": "object", "additionalProperties": { "type": "string" } }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidenceId", "assetId", "evidenceType", "sourceTier", "sourceName", "sourceRef", "publicationDate", "retrievedAt", "factualClaim", "confidence", "verificationStatus"],
            "properties": {
              "evidenceId": { "type": "string" },
              "assetId": { "type": ["string", "null"] },
              "evidenceType": { "enum": ["officialFiling", "marketData", "institutionalResearch", "macroIntelligence", "financialNews", "sentiment"] },
              "sourceTier": { "type": "integer", "minimum": 1, "maximum": 6 },
              "sourceName": { "type": "string" },
              "sourceRef": { "type": "string" },
              "publicationDate": { "type": "string", "format": "date-time" },
              "retrievedAt": { "type": "string", "format": "date-time" },
              "effectiveDate": { "type": ["string", "null"], "format": "date-time" },
              "expiresAt": { "type": ["string", "null"], "format": "date-time" },
              "factor": {
                "type": ["string", "null"],
                "enum": ["valuation", "financialStrength", "businessQuality", "growth", "macro", "technical", "portfolioFit", "governance", null]
              },
              "claimKey": { "type": ["string", "null"] },
              "factualClaim": { "type": "string" },
              "normalizedValue": { "type": ["number", "null"] },
              "unit": { "type": ["string", "null"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
              "verificationStatus": { "enum": ["verified", "unverified", "disputed"] },
              "conflictGroupId": { "type": ["string", "null"] },
              "notes": { "type": ["string", "null"] }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["conflictId", "claimKey", "evidenceIds", "prevailingEvidenceId", "severity", "resolution", "confidenceEffect", "note"],
            "properties": {
              "conflictId": { "type": "string" },
              "claimKey": { "type": "string" },
              "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
              "prevailingEvidenceId": { "type": "string" },
              "severity": { "enum": ["low", "high"] },
              "resolution": { "enum": ["unresolved", "resolved_by_tier", "resolved_manually"] },
              "confidenceEffect": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["assetId", "status", "totalScore", "finalRating", "confidence", "evidenceIntegrity", "engineVersion", "modelVersion", "eligibilityChecks", "vetoes", "factorScores", "recommendationRationale", "insufficientReasons", "invalidationConditions", "conflictIds"],
            "properties": {
              "assetId": { "type": "string" },
              "status": { "enum": ["rated", "insufficient_evidence"] },
              "totalScore": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
              "provisionalRating": { "type": ["string", "null"] },
              "finalRating": { "type": ["string", "null"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
              "evidenceIntegrity": { "type": "number", "minimum": 0, "maximum": 100 },
              "valuationDate": { "type": ["string", "null"], "format": "date-time" },
              "engineVersion": { "type": "string" },
              "modelVersion": { "type": "string" },
              "eligibilityChecks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label", "passed", "actual", "required"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "passed": { "type": "boolean" },
                    "actual": { "type": "string" },
                    "required": { "type": "string" }
                  }
                }
              },
              "vetoes": { "type": "array", "items": { "type": "string" } },
              "factorScores": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["factorName", "rawScore", "adjustedScore", "weight", "weightedContribution", "confidence", "freshnessPenalty", "coveragePenalty", "conflictPenalty", "evidenceCoverage", "evidenceIds", "rationale", "missingInputs", "limitations"],
                  "properties": {
                    "factorName": { "enum": ["valuation", "financialStrength", "businessQuality", "growth", "macro", "technical", "portfolioFit", "governance"] },
                    "rawScore": { "type": ["number", "null"] },
                    "adjustedScore": { "type": ["number", "null"] },
                    "weight": { "type": "number", "minimum": 0, "maximum": 1 },
                    "weightedContribution": { "type": ["number", "null"] },
                    "confidence": { "type": "number" },
                    "freshnessPenalty": { "type": "number", "minimum": 0 },
                    "coveragePenalty": { "type": "number", "minimum": 0 },
                    "conflictPenalty": { "type": "number", "minimum": 0 },
                    "evidenceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
                    "evidenceIds": { "type": "array", "items": { "type": "string" } },
                    "rationale": { "type": "string" },
                    "missingInputs": { "type": "array", "items": { "type": "string" } },
                    "limitations": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "valuation": {
                "type": ["object", "null"],
                "required": ["method", "modelVersion", "calculationDate", "inputs", "assumptions", "evidenceIds", "currency", "sensitivity", "confidence", "invalidationConditions", "limitations"],
                "properties": {
                  "method": { "enum": ["discountedCashFlow", "ownerEarnings", "earningsMultiple", "dividendModel", "netAssetValue", "yieldSpread", "relativeValuation", "replacementCost", "goldStrategicAllocation", "cashEquivalentYield"] },
                  "modelVersion": { "type": "string" },
                  "calculationDate": { "type": "string", "format": "date-time" },
                  "inputs": { "type": "object" },
                  "assumptions": { "type": "array", "items": { "type": "string" } },
                  "evidenceIds": { "type": "array", "items": { "type": "string" } },
                  "conservativeValue": { "type": ["number", "null"] },
                  "baseValue": { "type": ["number", "null"] },
                  "optimisticValue": { "type": ["number", "null"] },
                  "marketPrice": { "type": ["number", "null"] },
                  "currency": { "type": "string" },
                  "marginOfSafety": { "type": ["number", "null"] },
                  "sensitivity": { "type": "string" },
                  "confidence": { "type": "number" },
                  "invalidationConditions": { "type": "array", "items": { "type": "string" } },
                  "limitations": { "type": "array", "items": { "type": "string" } }
                }
              },
              "marginOfSafety": { "type": ["number", "null"] },
              "downsideCase": { "type": ["string", "null"] },
              "baseCase": { "type": ["string", "null"] },
              "upsideCase": { "type": ["string", "null"] },
              "portfolioFit": { "type": ["string", "null"] },
              "recommendationRationale": { "type": "string" },
              "insufficientReasons": { "type": "array", "items": { "type": "string" } },
              "invalidationConditions": { "type": "array", "items": { "type": "string" } },
              "conflictIds": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "posture": {
          "type": "object",
          "required": ["deploymentScore", "deploymentBand", "recommendation", "acceleratorPosture", "maximumInitialTranche", "reserveRequirement", "confidence", "evidenceIntegrity", "marketScore", "cashScore", "opportunityIndex", "strongBuyCount", "concentrationRisk", "liquidityRisk", "rationale", "constraints", "wouldIncrease", "wouldDecrease", "generatedAt", "engineVersion"],
          "properties": {
            "deploymentScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "deploymentBand": { "type": "string" },
            "recommendation": { "type": "string" },
            "acceleratorPosture": { "type": "string" },
            "maximumInitialTranche": { "type": "number", "minimum": 0, "maximum": 1 },
            "reserveRequirement": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
            "evidenceIntegrity": { "type": "number", "minimum": 0, "maximum": 100 },
            "marketScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "cashScore": { "type": "number", "minimum": 0, "maximum": 100 },
            "opportunityIndex": { "type": "number", "minimum": 0, "maximum": 100 },
            "strongBuyCount": { "type": "integer", "minimum": 0 },
            "concentrationRisk": { "type": "number", "minimum": 0, "maximum": 100 },
            "liquidityRisk": { "type": "number", "minimum": 0, "maximum": 100 },
            "rationale": { "type": "array", "items": { "type": "string" } },
            "constraints": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["id", "description", "capApplied"],
                "properties": {
                  "id": { "type": "string" },
                  "description": { "type": "string" },
                  "capApplied": { "type": "number" }
                }
              }
            },
            "wouldIncrease": { "type": "array", "items": { "type": "string" } },
            "wouldDecrease": { "type": "array", "items": { "type": "string" } },
            "generatedAt": { "type": "string", "format": "date-time" },
            "engineVersion": { "type": "string" }
          }
        },
        "evidenceSummary": {
          "type": "object",
          "required": ["total", "byFreshness", "verifiedShare"],
          "properties": {
            "total": { "type": "integer" },
            "byFreshness": { "type": "object", "additionalProperties": { "type": "integer" } },
            "verifiedShare": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "changeLog": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "insufficientEvidenceItems": { "type": "array", "items": { "type": "string" } },
        "journalEntry": {
          "type": "object",
          "required": ["entryId", "recommendationId", "timestamp", "reportHash", "summary", "deploymentScore", "recommendation", "engineVersion", "modelVersion", "integrityHash"],
          "properties": {
            "entryId": { "type": "string" },
            "recommendationId": { "type": "string" },
            "timestamp": { "type": "string", "format": "date-time" },
            "reportHash": { "type": "string" },
            "summary": { "type": "string" },
            "deploymentScore": { "type": "number" },
            "recommendation": { "type": "string" },
            "engineVersion": { "type": "string" },
            "modelVersion": { "type": "string" },
            "userDecision": { "type": ["string", "null"] },
            "executionDetails": { "type": ["string", "null"] },
            "outcome": { "type": ["string", "null"] },
            "reviewNotes": { "type": ["string", "null"] },
            "supersedes": { "type": ["string", "null"] },
            "integrityHash": { "type": "string" }
          }
        }
      }
    }
  }
}
