# NeoOS CIO — Environment Configuration
# Copy to .env.local and fill in your values. Server-side only (never in browser).
# No variable here is prefixed NEXT_PUBLIC_ — that's structurally impossible for Next.js to inline.

# ============================================================================
# REQUIRED FOR PRODUCTION
# ============================================================================

# PostgreSQL connection string (any provider: Supabase, Neon, RDS, local).
# Use a session-mode pooler on serverless hosts; transaction-mode fails on
# multi-statement DDL (the schema migrations).
# Example: postgresql://user:password@host:5432/postgres?sslmode=require
DATABASE_URL=

# Bearer token for manual runs and the Run button. Generate with:
#   openssl rand -base64 32
# Treat as a household secret — anyone holding it has the full position.
OPERATOR_API_TOKEN=

# ============================================================================
# REQUIRED FOR EVIDENCE & LIVE DATA
# ============================================================================

# SEC EDGAR User-Agent (free, no credential).
# Identifies the requester to the SEC. Example: "NeoOS CIO you@yourdomain.com"
# Without this, SEC filings are unavailable and fundamentals cannot be computed.
SEC_EDGAR_USER_AGENT=

# ============================================================================
# OPTIONAL: PREMIUM MARKET DATA
# ============================================================================

# Market data provider (licensed, paid optional).
# Leave unset for manual price entry. When set with an API key:
# - US and global equity prices update at venue latency
# - FX and Treasury yields work correctly
MARKET_DATA_BASE_URL=
MARKET_DATA_API_KEY=

# How the provider describes this data's timeliness (free, for labeling).
# Example: "Real-time" or "15 minute delayed"
MARKET_DATA_TIMELINESS=

# Gold/metals pricing provider (licensed, paid optional).
# Gold-API.com is used by default (free, keyless). Set these to override.
METALS_BASE_URL=
METALS_API_KEY=

# ============================================================================
# OPTIONAL: REPORT SIGNING & VERIFICATION
# ============================================================================

# Ed25519 private key for report signatures (free, local generation).
# Generate with:
#   node -e "
#   const {generateKeyPairSync,createHash}=require('crypto');
#   const {privateKey,publicKey}=generateKeyPairSync('ed25519');
#   const pub=publicKey.export({type:'spki',format:'der'});
#   console.log('REPORT_SIGNING_PRIVATE_KEY=' + privateKey.export({type:'pkcs8',format:'der'}).toString('base64url'));
#   console.log('REPORT_SIGNING_KEY_ID=ed25519-' + createHash('sha256').update(pub).digest('hex').slice(0,16));
#   "
# Publish the public key so auditors can verify signatures.
REPORT_SIGNING_PRIVATE_KEY=

# Key ID derived from the key (optional, defaults to "unconfigured").
# Set this only if you've configured the private key above.
REPORT_SIGNING_KEY_ID=

# ============================================================================
# OPTIONAL: SCHEDULED RUNS
# ============================================================================

# Bearer token for the scheduled-run endpoint (/api/cron/daily).
# Generate with: openssl rand -base64 32
# Vercel sends Authorization: Bearer $CRON_SECRET on every scheduled run.
CRON_SECRET=

# ============================================================================
# OPTIONAL: NOTIFICATIONS & INTEGRATIONS
# ============================================================================

# Webhook URL for findings and alerts.
# When set, critical findings are pushed here in addition to being returned
# in the response. Leave unset to return findings only.
NOTIFICATION_WEBHOOK_URL=

# ============================================================================
# OPTIONAL: DATABASE CERTIFICATE VERIFICATION
# ============================================================================

# PEM certificate authority for database TLS (free, for security).
# Set this if your database provider signs with a custom CA (Supabase, Neon, etc).
# Paste the provider's PEM certificate here to authenticate the server.
# Without this, fallback to sslmode=no-verify (encrypts but doesn't authenticate).
# Example: obtain from Supabase Dashboard > Database > CA Certificate
DATABASE_CA_CERT=

# ============================================================================
# DEPLOYMENT READINESS
# ============================================================================

# To go live, verify all three of these are passing in GET /api/health:
#   1. database: true          (DATABASE_URL is set and reachable)
#   2. operatorApi: true       (OPERATOR_API_TOKEN is set)
#   3. At least one of:
#      - secEdgar: true        (SEC_EDGAR_USER_AGENT is set)
#      - marketData: true      (MARKET_DATA_BASE_URL and MARKET_DATA_API_KEY)
#      - metals: true          (METALS_BASE_URL and METALS_API_KEY)
#
# With these three, the app can run live reports.
# All other configuration opens additional features without blocking deployment.
